{
  "schema": 3,
  "plugin_id": "managed-web-example",
  "name": "托管网页插件示例",
  "version": "1.0.0",
  "min_framework": "2.5.3",
  "author": "Example Developer",
  "description": "通过托管 WebSocket 连接框架并提供管理后台",
  "notes": "首次发布，提供独立管理后台。",
  "runtime": {
    "entry": "bin/my-plugin",
    "args": ["--connection", "{connection}"],
    "transport": "websocket-v1",
    "health_path": "/api/managed/health",
    "admin": true
  }
}
